[Unit]
Description=FreeLLMAPI self-hosted LLM gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freellmapi
Group=freellmapi
WorkingDirectory=/opt/freellmapi
Environment=NODE_ENV=production
Environment=PORT=3001
# One of: local | cloudflare | tailscale | ngrok
Environment=TUNNEL=local
# Public modes only — never put a real token in this unit file. Use an
# EnvironmentFile with 0600 permissions or systemd credentials instead.
#EnvironmentFile=/etc/freellmapi/gateway.env
ExecStart=/usr/bin/node /opt/freellmapi/server/dist/index.js
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening. The tunnel child (cloudflared/tailscale/ngrok) needs its own
# binary on PATH; install it system-wide or add its directory to ExecStart's
# environment with an Environment= PATH=... line.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/freellmapi/server/data

[Install]
WantedBy=multi-user.target
